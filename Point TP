local SlotButtons = {}
local ToggleResets = {}

for i = 1, 3 do
    local saveToggle, saveStroke, setSaveState = createToggleButton("Save Point " .. i, i * 2 - 1, function(state)
        if state then
            local ch = LocalPlayer.Character
            if not ch then showToast("Character tidak ditemukan") setSaveState(false, true) return end
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if not hrp then showToast("HumanoidRootPart hilang") setSaveState(false, true) return end

            Checkpoints[i].cframe = hrp.CFrame
            createGhost(i, Checkpoints[i].cframe)
            showToast("Menyimpan Point " .. i)
            
            local tpBtn = SlotButtons[i].tpBtn
            local tpStroke = SlotButtons[i].tpStroke
            tpBtn.Active = true
            TweenService:Create(tpBtn, TweenInfo.new(0.25), {
                TextColor3 = COLOR_TEXT, BackgroundTransparency = 0
            }):Play()
            TweenService:Create(tpStroke, TweenInfo.new(0.25), {
                Color = COLOR_ACCENT, Transparency = 0.3
            }):Play()
        else
            Checkpoints[i].cframe = nil
            if Checkpoints[i].ghost then
                Checkpoints[i].ghost:Destroy()
                Checkpoints[i].ghost = nil
            end
            showToast("Point " .. i .. " dimatikan")
            
            local tpBtn = SlotButtons[i].tpBtn
            local tpStroke = SlotButtons[i].tpStroke
            tpBtn.Active = false
            TweenService:Create(tpBtn, TweenInfo.new(0.25), {
                TextColor3 = COLOR_TEXT_DIM, BackgroundTransparency = 0.5
            }):Play()
            TweenService:Create(tpStroke, TweenInfo.new(0.25), {
                Color = COLOR_ACCENT_D, Transparency = 0.5
            }):Play()
        end
    end)
    
    ToggleResets[i] = setSaveState

    local tpBtn, tpStroke = createButton("Teleport Point " .. i, i * 2, "tp")
    tpBtn.BackgroundTransparency = 0.5
    tpBtn.TextColor3 = COLOR_TEXT_DIM
    tpBtn.Active = false

    SlotButtons[i] = {
        saveToggle = saveToggle,
        saveStroke = saveStroke,
        tpBtn = tpBtn,
        tpStroke = tpStroke,
    }

    tpBtn.MouseButton1Click:Connect(function()
        if not Checkpoints[i].cframe then return end
        local ch = LocalPlayer.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        hrp.CFrame = Checkpoints[i].cframe
        showToast("Teleported ke Point " .. i)
    end)
end

