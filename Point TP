--============================================================
local iconDrag = nil
Icon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        iconDrag = { input = input, startPos = Icon.Position, startMouse = input.Position, moved = false, startTime = tick() }
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not iconDrag or input ~= iconDrag.input then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - iconDrag.startMouse
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then iconDrag.moved = true end
        if iconDrag.moved then
            Icon.Position = UDim2.new(iconDrag.startPos.X.Scale, iconDrag.startPos.X.Offset + delta.X, iconDrag.startPos.Y.Scale, iconDrag.startPos.Y.Offset + delta.Y)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not iconDrag or input ~= iconDrag.input then return end
    if not iconDrag.moved and (tick() - iconDrag.startTime) < 0.6 then
        if Menu.Visible then closeMenu() else openMenu() end
    end
    iconDrag = nil
end)

local menuDrag = nil
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if input.Position.X > closeBtn.AbsolutePosition.X and input.Position.X < closeBtn.AbsolutePosition.X + closeBtn.AbsoluteSize.X
        and input.Position.Y > closeBtn.AbsolutePosition.Y and input.Position.Y < closeBtn.AbsolutePosition.Y + closeBtn.AbsoluteSize.Y then return end
        menuDrag = { input = input, startPos = Menu.Position, startMouse = input.Position }
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not menuDrag or input ~= menuDrag.input then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - menuDrag.startMouse
        Menu.Position = UDim2.new(menuDrag.startPos.X.Scale, menuDrag.startPos.X.Offset + delta.X, menuDrag.startPos.Y.Scale, menuDrag.startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if menuDrag and input == menuDrag.input then menuDrag = nil end
end)

